<!-- ULDB: the view of upstream's StatisticsControl (Controls/StatisticsControl.cs, model-ported).
     Controls named like upstream's fields are bound to them by ModelBinder.BindByName. Order follows
     upstream's designer; the look is ULDB's: one row of count-over-label tiles instead of a five-line list. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uldb="clr-namespace:ULDB.Controls"
             x:Class="CodeImp.DoomBuilder.Controls.StatisticsView">
  <Border Classes="uldb-card" Margin="0" Padding="8,6">
    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
      <StackPanel Grid.Column="0" MinWidth="76" Margin="0,0,4,0" VerticalAlignment="Center">
        <TextBlock x:Name="verticescount" HorizontalAlignment="Center" FontSize="18" LineHeight="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="verticeslabel" HorizontalAlignment="Center" FontSize="11" LineHeight="14" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="1" MinWidth="76" Margin="0,0,4,0" VerticalAlignment="Center">
        <TextBlock x:Name="linedefscount" HorizontalAlignment="Center" FontSize="18" LineHeight="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="linedefslabel" HorizontalAlignment="Center" FontSize="11" LineHeight="14" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="2" MinWidth="76" Margin="0,0,4,0" VerticalAlignment="Center">
        <TextBlock x:Name="sidedefscount" HorizontalAlignment="Center" FontSize="18" LineHeight="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="sidedefslabel" HorizontalAlignment="Center" FontSize="11" LineHeight="14" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="3" MinWidth="76" Margin="0,0,4,0" VerticalAlignment="Center">
        <TextBlock x:Name="sectorscount" HorizontalAlignment="Center" FontSize="18" LineHeight="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="sectorslabel" HorizontalAlignment="Center" FontSize="11" LineHeight="14" Opacity="0.6"/>
      </StackPanel>
      <StackPanel Grid.Column="4" MinWidth="76" Margin="0,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="thingscount" HorizontalAlignment="Center" FontSize="18" LineHeight="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="thingslabel" HorizontalAlignment="Center" FontSize="11" LineHeight="14" Opacity="0.6"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
